type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Size = 
 record {
   price: Price;
   sizeLabel: text;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 variant {
   err: OrderError;
   ok: Order;
 };
type Price = nat;
type OrderItemRequest = 
 record {
   fragranceId: FragranceId;
   quantity: nat;
   sizeLabel: text;
 };
type OrderId = nat;
type OrderError = 
 variant {
   emptyOrder;
   invalidQuantity: record {
                      fragranceId: FragranceId;
                      sizeLabel: text;
                    };
   unknownFragrance: FragranceId;
   unknownSize: record {
                  fragranceId: FragranceId;
                  sizeLabel: text;
                };
 };
type Order = 
 record {
   delivery: DeliveryDetails;
   id: OrderId;
   items: vec LineItem;
   total: Price;
 };
type LineItem = 
 record {
   fragranceId: FragranceId;
   lineTotal: Price;
   quantity: nat;
   sizeLabel: text;
 };
type FragranceId = nat;
type Fragrance = 
 record {
   description: text;
   id: FragranceId;
   name: text;
   notes: vec text;
   sizes: vec Size;
   tagline: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DeliveryDetails = 
 record {
   address: text;
   city: text;
   country: text;
   email: text;
   fullName: text;
   postalCode: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result__1) query;
  /// Return the backend API documentation as static Markdown.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Return a single fragrance by id, or null when it does not exist.
  getFragrance: (id: FragranceId) -> (opt Fragrance) query;
  isCallerAdmin: () -> (bool) query;
  /// Return every fragrance in the catalogue.
  listFragrances: () -> (vec Fragrance) query;
  /// Place a demo order from the supplied delivery details and requested items.
  placeOrder: (delivery: DeliveryDetails, items: vec OrderItemRequest) ->
   (Result);
  schema: () -> (text) query;
}
